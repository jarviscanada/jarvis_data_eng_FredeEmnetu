pipeline {
    agent any

    environment {
        app_name = 'trading-app'

        // Init Credentials
        AZ_USER = credentials('AZ_USER')
        AZ_PWD = credentials('AZ_PWD')
        AZ_TENANT = credentials('AZ_TENANT')

        // Build & Deploy Config
        ACR_NAME = 'feridclusternameregistry'
        RESOURCE_GROUP = 'rg-ferid'
        CLUSTER_NAME = 'ferid-cluster-name'
        DOCKER_REPO = 'feridclusternameregistry.azurecr.io'
        DEPLOYMENT_NAME = 'trading-app'
    }

    stages {
        stage('Calculate Version') {
            steps {
                script {
                    int buildIndex = env.BUILD_NUMBER.toInteger() - 1
                    int major = 1 + (buildIndex / 10).toInteger()
                    int minor = buildIndex % 10
                    env.IMAGE_TAG = "${major}.${minor}"
                    env.FULL_IMAGE_NAME = "tradingapp:${env.IMAGE_TAG}"
                    echo "Target Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }
        
        stage('Init') {
            steps {
                script {
                    // 1. Verify az is available on the agent
                    sh 'az --version'
                    
                    // 2. Authenticate with Azure Service Principal
                    sh 'az login --service-principal --username ${AZ_USER} --password ${AZ_PWD} --tenant ${AZ_TENANT}'
                }
            }
        }
        
        stage('Build') {
            steps {
                sh 'az acr build --image ${FULL_IMAGE_NAME} --registry $ACR_NAME --file spring_boot/Dockerfile spring_boot/'
            }
        }
        
        stage('Deploy') {
            steps {
                sh 'az aks get-credentials --name $CLUSTER_NAME --resource-group $RESOURCE_GROUP'
                sh 'kubectl cluster-info'
                sh 'kubectl set image deployment/${DEPLOYMENT_NAME} trading-app-container=${DOCKER_REPO}/${FULL_IMAGE_NAME}'
                sh 'kubectl get all'
            }
        }
    }
}